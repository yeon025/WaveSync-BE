# ==================================================
# PostgreSQL
# ==================================================

# 데이터베이스 이름
POSTGRES_DB=wawu

# 데이터베이스 계정
POSTGRES_USER=wawu

# 데이터베이스 비밀번호
POSTGRES_PASSWORD=wawu


# ==================================================
# MinIO
# ==================================================

# MinIO 관리자 계정
MINIO_ROOT_USER=admin

# MinIO 관리자 비밀번호
MINIO_ROOT_PASSWORD=password123

# MinIO 내부 접근 주소 (Docker 네트워크 기준)
MINIO_ENDPOINT=http://minio:9000


# ==================================================
# MinIO 버킷
# ==================================================

# 사용자 프로필 이미지 저장 버킷
MINIO_BUCKET_PROFILE_IMAGES=profile-images

# 에코 이미지 저장 버킷
MINIO_BUCKET_ECHO_IMAGES=echo-images

# 무기 이미지 저장 버킷
MINIO_BUCKET_WEAPON_IMAGES=weapon-images

# 공명자 썸네일 이미지 저장 버킷
MINIO_BUCKET_RESONATOR_THUMBNAILS=resonator-thumbnail-images

# 공명자 전체 이미지 저장 버킷
MINIO_BUCKET_RESONATOR_STANDING=resonator-standing-images


# ==================================================
# Spring Boot
# ==================================================

# 실행 환경 (dev / prod)
SPRING_PROFILES_ACTIVE=dev


# ==================================================
# FastAPI
# ==================================================

# 실행 환경 (dev / prod)
APP_ENV=dev